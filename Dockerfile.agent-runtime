FROM python:3.11.15-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 UV_COMPILE_BYTECODE=0 \
    OTEL_SDK_DISABLED=true CREWAI_DISABLE_TELEMETRY=true CREWAI_TRACING_ENABLED=false DO_NOT_TRACK=1 \
    AI_OFFICE_DATA_DIR=/tmp/ai-office-agents HOME=/tmp
RUN pip install --no-cache-dir uv==0.11.33 && useradd --uid 10001 --create-home office
WORKDIR /srv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --extra agents --no-install-project
COPY --chown=office:office app ./app
RUN uv sync --frozen --no-dev --extra agents
ENV PATH="/srv/.venv/bin:$PATH"
USER 10001:10001
CMD ["uvicorn", "app.agent_runtime:create_app", "--factory", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]
